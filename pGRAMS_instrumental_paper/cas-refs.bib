url = {https://www.sciencedirect.com/science/article/pii/S0168900222005721},
author = {Andrea Falcone},
keywords = {Neutrino detector},
abstract = {DUNE is the most ambitious long-baseline experiment under construction in the US for the study of neutrino oscillation and astroparticle physics. The DUNE far detector consists of four modules (17 kton each) based on the Liquid Argon TPC technology and enhanced by a powerful Photon Detection System (PDS) that records the 128 nm scintillation light emitted by argon. The article will cover the main characteristics of the Near Detector and of the two first far detector modules, Horizontal and Vertical Drift respectively, together with the description of the dedicated R&D carried out. A particular emphasis will be given to the characterization of the PDS.}
}

